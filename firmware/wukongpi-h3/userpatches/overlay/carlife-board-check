#!/bin/bash
# Read-only hardware report. Does not change USB roles or expose Wi-Fi passwords.
set -u
section() { printf '\n### %s\n' "$1"; }
run() { if command -v "$1" >/dev/null 2>&1; then "$@" 2>&1 || true; fi; }
section 'Firmware and board'
cat /etc/carlife-firmware-info 2>/dev/null || true
if [[ -r /proc/device-tree/model ]]; then tr '\0' '\n' < /proc/device-tree/model; fi
run uname -a
run free -h
run lsblk -o NAME,SIZE,TYPE,MOUNTPOINTS
section 'CPU and thermal'
for path in /sys/class/thermal/thermal_zone*/temp /sys/devices/system/cpu/cpufreq/policy*/scaling_max_freq; do
    [[ ! -r "$path" ]] || printf '%s: %s\n' "$path" "$(cat "$path")"
done
section 'USB host devices'
run lsusb
run lsusb -t
section 'USB device controllers (UDC)'
if [[ -d /sys/class/udc ]]; then
    find /sys/class/udc -mindepth 1 -maxdepth 1 -printf '%f\n'
    for path in /sys/class/udc/*/state /sys/class/udc/*/current_speed; do
        [[ ! -r "$path" ]] || printf '%s: %s\n' "$path" "$(cat "$path")"
    done
fi
section 'Gadget and FunctionFS support'
run lsmod
if [[ -r /boot/config-$(uname -r) ]]; then
    grep -E '^CONFIG_(USB_(GADGET|MUSB|CONFIGFS)|USB_F_FS|USB_FUNCTIONFS)' /boot/config-"$(uname -r)" || true
elif [[ -r /proc/config.gz ]]; then
    zcat /proc/config.gz | grep -E '^CONFIG_(USB_(GADGET|MUSB|CONFIGFS)|USB_F_FS|USB_FUNCTIONFS)' || true
fi
section 'Network and radio capabilities'
run ip -brief address
run rfkill list
run iw dev
run iw list
run nmcli -f DEVICE,TYPE,STATE device
run bluetoothctl list
section 'Recent kernel messages'
run dmesg --level=err,warn
printf '\nThis is a hardware bring-up image; Linux CarLife/CarPlay bridge is not installed.\n'
